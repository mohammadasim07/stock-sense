# StockSense — Environment Variables
# Copy this file to .env before running: cp .env.example .env

# Database (Optional: StockSense automatically falls back to in-memory/JSON demo mode if PostgreSQL is not running)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stocksense"

# NextAuth Authentication
NEXTAUTH_SECRET="stocksense-hackathon-super-secret-key-2024"
NEXTAUTH_URL="http://localhost:3000"

# Mock OTP for instant login/testing
MOCK_OTP="123456"
